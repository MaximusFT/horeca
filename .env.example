# The demo stays in free deterministic local-agent mode unless this is explicitly enabled.
AGENT_MODE=local

# Supplier execution remains offline unless Silpo is explicitly selected.
SUPPLIER_MODE=mock

# The official OAuth 2.1 + PKCE flow starts explicitly from /debug/mcp.
# The endpoint is fixed to https://mcp.silpo.ua/mcp; no static token is required.
# Select live supplier execution only after tools/list schemas are captured and mapped:
# SUPPLIER_MODE=silpo

# Optional legacy direct-token diagnostics only:
# SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# SILPO_MCP_ACCESS_TOKEN=

# Durable encrypted Silpo OAuth storage for Vercel/serverless deployments.
# Without all three values, local development falls back to process memory.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
# Generate locally: openssl rand -base64 32
# SILPO_OAUTH_ENCRYPTION_KEY=...

# Optional live Responses API mode (server-side only):
# AGENT_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
