# The demo stays in free deterministic local-agent mode unless this is explicitly enabled.
AGENT_MODE=local

# Supplier execution remains offline unless Silpo is explicitly selected.
SUPPLIER_MODE=mock

# Enable only after Silpo OAuth authorization and the Stage 9 tools/list spike:
# SUPPLIER_MODE=silpo
# SILPO_MCP_URL=
# SILPO_MCP_ACCESS_TOKEN=

# Optional live Responses API mode (server-side only):
# AGENT_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
